# Don't commit binaries
*.a
*.asm
*.dll
*.dylib
*.exe
*.lib
*.out
*.o
*.so
*.so.*
# Clang cache
.cache/
# Exclude editor config
.vscode/
.vs/
# Exclude temporary folders
*.egg-info/
.eggs/
build/
build_cmake/
# Local working-tree backups of uncommitted changes (see backup/RESTORE.md)
backup/
# Exclude macOS folder attributes
.DS_Store
# Exclude macOS Info.framework.plist
Info.framework.plist
# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# MuJoCo
MUJOCO_LOG.TXT
MJDATA.TXT
MJMODEL.TXT
# Python
python/dist/
# Agent working scratch
.superpowers/
docs/plans/
docs/specs/
# Lean contact-selection study: the SCRIPTS and the sweep RESULTS (json) are tracked;
# the bulk rollout logs and rendered media are not -- they are regenerable from the
# scripts and would add ~50 MB. docs/lean/media is rebuilt by studies/make_videos.py.
studies/*.csv
studies/*.png
studies/strat2.log
docs/lean/media/
docs/lean/media_old/
studies/videos.log
studies/runs/

# scratch backups: use git, not .bak files (archived 2026-08-06, icra2026)
*.bak
*.bak.*

# staged model tree (stage_assets.sh STAGE_ROOT default for a root-owned build/)
studies/runs/_stage/
