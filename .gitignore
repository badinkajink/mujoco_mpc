# Don't commit binaries
*.a
*.asm
*.dll
*.dylib
*.exe
*.lib
*.out
*.o
*.so
*.so.*
# Clang cache
.cache/
# Exclude editor config
.vscode/
.vs/
# Exclude temporary folders
*.egg-info/
.eggs/
build/
build_cmake/
# Local working-tree backups of uncommitted changes (see backup/RESTORE.md)
backup/
# Exclude macOS folder attributes
.DS_Store
# Exclude macOS Info.framework.plist
Info.framework.plist
# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# MuJoCo
MUJOCO_LOG.TXT
MJDATA.TXT
MJMODEL.TXT
# Python
python/dist/
# Agent working scratch
.superpowers/
docs/plans/
docs/specs/

# scratch backups: use git, not .bak files (archived 2026-08-06)
*.bak
*.bak.*

# --- wxie/table-height ------------------------------------------------------
# Raw sweep outputs: large (300+ MB), regenerable from studies/*/sweep.py, and
# meaningless without the binary that produced them. The figures + summary JSON
# a doc page depends on ARE committed, under docs/lean/media/.
studies/runs/
studies/*/runs/
studies/**/__pycache__/
# Analysis output: `make_page.py` copies the figures a page needs into
# docs/lean/media/, which IS committed. Keeping studies/*/figs/ as well would
# ship two copies of every PNG and let them drift.
studies/*/figs/
studies/*/figs_*/
studies/*/*.log
