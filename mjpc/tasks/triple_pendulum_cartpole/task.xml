<mujoco model="Triple Pendulum Cartpole">
  <include file="../common.xml"/>

  <!--
    Triple pendulum on a cart, threading a corridor of obstacles.

    This is the benchmark system from:
      T. M. Caldwell and N. Correll, "Fast Sample-Based Planning for Dynamic
      Systems by Zero-Control Linearization-Based Steering", ISRR 2015.
      (Section 5, "Examples and Algorithm")

    Physical parameters follow the paper exactly:
      cart mass                1.0 kg
      3 links, total length    1.0 m  (each link 1/3 m, massless rod)
      head mass (per link)     0.1 kg
      gravity                  9.81 m/s^2
      control                  force on the cart, |u| <= 20 N
      obstacles                disks of radius 0.6 at (x,z) = (3, +0.85), (3, -0.85)
      start                    cart x = 0, all links upright (theta = 0)
      goal                     cart x = 6, all links upright

    Angle convention matches the reference implementation: theta_i = 0 points
    the link along +z (up), so a head sits at
      x = x_cart + sum_j L*sin(theta_j),  z = sum_j L*cos(theta_j).

    The two obstacles leave a gap of 2*(0.85 - 0.6) = 0.5 m centred on the
    rail, so a 1 m pendulum cannot pass upright: it has to be swung down and
    laid out near-horizontal to thread the corridor, then re-erected. The
    3-link system is chaotic and underactuated (nu = 1, nv = 4).
  -->

  <option timestep="0.005" integrator="implicitfast">
    <flag contact="enable"/>
  </option>

  <size memory="1M"/>

  <custom>
    <!-- agent -->
    <numeric name="agent_planner" data="0" />
    <numeric name="agent_horizon" data="1.0" />
    <numeric name="agent_timestep" data="0.005" />
    <numeric name="agent_policy_width" data="0.0035" />

    <!-- sampling / cross-entropy / pso share these -->
    <numeric name="sampling_spline_points" data="12" />
    <numeric name="sampling_exploration" data="0.4" />
    <numeric name="sampling_representation" data="1" />
    <numeric name="gradient_spline_points" data="12" />

    <!-- Rollout budget, stated explicitly so the planners are comparable.
         The library defaults disagree: SamplingPlanner and CrossEntropy
         default to 10 trajectories but PSO defaults to 20 particles, so
         leaving these unset silently hands PSO twice the rollouts of
         everything it is being compared against. -->
    <numeric name="sampling_trajectories" data="10" />
    <numeric name="pso_num_particles" data="10" />

    <!-- 1: PSO publishes the parameters it rolled out. 0: it publishes the
         post-swarm-update iterate, whose cost was never evaluated. -->
    <numeric name="pso_publish_evaluated" data="1" />

    <!-- goal cart position; slider range is [-1, 8] -->
    <numeric name="residual_Goal" data="6.0 -1.0 8.0" />
    <!-- clearance (m) added to the obstacle radius before the avoidance cost
         starts charging; 0 means "cost only once already overlapping" -->
    <numeric name="residual_Clearance" data="0.08 0.0 0.5" />
  </custom>

  <default>
    <default class="link">
      <joint type="hinge" axis="0 1 0" limited="false" damping="0.0"/>
      <!-- rods are massless: mass="0" so only the head spheres carry inertia -->
      <geom type="capsule" size="0.012" mass="0" material="self"
            contype="1" conaffinity="2"/>
    </default>
    <default class="head">
      <geom type="sphere" size="0.028" mass="0.1" material="effector"
            contype="1" conaffinity="2"/>
    </default>
    <default class="obstacle">
      <geom type="cylinder" size="0.6 0.05" quat="0.7071068 0.7071068 0 0"
            rgba=".85 .15 .15 1" contype="2" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 -2 4" dir="0 .4 -1" diffuse=".8 .8 .8"/>

    <!-- rail: visual only (contype/conaffinity = 0) -->
    <geom name="rail" type="capsule" fromto="-1.2 0 0  8.2 0 0" size="0.018"
          material="decoration" contype="0" conaffinity="0"/>

    <!-- start and goal markers -->
    <site name="start" pos="0 0 0" size="0.04" rgba=".3 .3 .3 .5"/>
    <site name="goal"  pos="6 0 0" size="0.05" material="target"/>

    <!-- obstacle corridor, per the paper: disks of r=0.6 at (3, +/-0.85) -->
    <geom name="obstacle_upper" class="obstacle" pos="3 0 0.85"/>
    <geom name="obstacle_lower" class="obstacle" pos="3 0 -0.85"/>

    <body name="cart" pos="0 0 0">
      <joint name="slider" type="slide" axis="1 0 0" range="-1 8" limited="true"
             damping="0.0"/>
      <geom name="cart" type="box" size="0.09 0.06 0.045" mass="1.0"
            material="self" contype="0" conaffinity="0"/>

      <body name="link1" childclass="link">
        <joint name="hinge1"/>
        <geom name="rod1" fromto="0 0 0  0 0 0.333333"/>
        <geom name="head1" class="head" pos="0 0 0.333333"/>
        <site name="head1" pos="0 0 0.333333" size="0.01" rgba="1 1 1 0"/>

        <body name="link2" pos="0 0 0.333333">
          <joint name="hinge2"/>
          <geom name="rod2" fromto="0 0 0  0 0 0.333333"/>
          <geom name="head2" class="head" pos="0 0 0.333333"/>
          <site name="head2" pos="0 0 0.333333" size="0.01" rgba="1 1 1 0"/>

          <body name="link3" pos="0 0 0.333333">
            <joint name="hinge3"/>
            <geom name="rod3" fromto="0 0 0  0 0 0.333333"/>
            <geom name="head3" class="head" pos="0 0 0.333333"/>
            <site name="tip" pos="0 0 0.333333" size="0.02" rgba="1 1 1 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="slide" joint="slider" ctrlrange="-20 20" gear="1"/>
  </actuator>

  <sensor>
    <!-- cost terms: norm type, weight, weight range..., norm params -->
    <user name="Cart"      dim="1" user="0 10.0  0.0 100.0"/>
    <user name="Upright"   dim="3" user="0 20.0  0.0 100.0"/>
    <user name="Velocity"  dim="4" user="0  0.1  0.0  10.0"/>
    <user name="Control"   dim="1" user="0  0.01 0.0   1.0"/>
    <user name="Avoidance" dim="6" user="0 50.0  0.0 500.0"/>

    <!-- trace of the pendulum tip, drawn by the GUI -->
    <framepos name="trace0" objtype="site" objname="tip"/>
  </sensor>

  <keyframe>
    <!-- start: cart at x=0, all three links at the upright (unstable) equilibrium -->
    <key name="home" qpos="0 0 0 0" qvel="0 0 0 0"/>
    <!--
      Fully hanging: theta_i = pi puts every link along -z. Used by the
      `balance` stage of corridor_benchmark.

      The `home` pose cannot serve as a balance test: it is a zero-control
      equilibrium, so "hold it" is solved by emitting u = 0 and every planner
      passes without searching. Starting hung makes swing-up and capture the
      only way to score, which is the capability the combined task actually
      needs and the one it cannot measure separately.
    -->
    <key name="hanging" qpos="0 3.14159265 3.14159265 3.14159265"
         qvel="0 0 0 0"/>
  </keyframe>
</mujoco>
